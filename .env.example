# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs referee court sessions (any long random string: openssl rand -hex 32)
SESSION_SECRET=

# Razorpay (Dashboard -> Settings -> API keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Browser alerts (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@flexonventures.in

# Public site URL (used in WhatsApp/email links)
NEXT_PUBLIC_SITE_URL=https://flexon-sports.vercel.app
