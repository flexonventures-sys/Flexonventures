# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp OTP delivery (Meta WhatsApp Cloud API). Supabase Auth issues and verifies codes;
# its Send SMS hook calls /api/hooks/send-sms, which delivers them on WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=   # only used by scripts/whatsapp-setup.mjs
WHATSAPP_OTP_TEMPLATE=flexon_login_code
WHATSAPP_OTP_LANG=en
# From Supabase -> Authentication -> Hooks -> Send SMS hook (looks like v1,whsec_...)
SEND_SMS_HOOK_SECRET=

# Razorpay (Dashboard -> Settings -> API keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Browser alerts (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@flexonventures.in

# Public site URL (used in WhatsApp/email links)
NEXT_PUBLIC_SITE_URL=https://flexon-sports.vercel.app
ADMIN_SECRET_PATH=

# WhatsApp webhook (delivery status). Verify token = any random string you put in the Meta webhook form.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=   # Meta App -> Settings -> Basic -> App secret
